    <string name="vo_rate">Speech rate</string>
    <string name="vo_pitch">Voice pitch</string>
    <string name="vo_engine_head">Text-to-speech (TTS) engine</string>
    <string name="vo_system_default">System default</string>
    <string name="vo_engine_desc">TTS engine, currently %1$s. Tap to change</string>
    <string name="vo_engine_note">Changing the engine takes effect immediately for the running service. The app only uses voices installed on the phone and never sends text over the network. Install a voice for your language in the chosen engine.</string>
    <string name="vo_test">Test the voice</string>
    <string name="vo_test_phrase">Hello, this is the reading voice.</string>
    <string name="vo_lang_head">App language</string>
    <string name="vo_lang_body">The app interface and spoken messages follow this language. The voice reads in the same language, so install a matching voice.</string>
    <string name="vo_lang_button">Choose app language</string>
    <string name="vo_lang_unavailable">Couldn\'t open language settings. Open Settings → System → Languages → App languages.</string>
    <string name="fbk_title">Sound and haptic</string>
    <string name="fbk_intro">Short feedback when focus moves, at the start/end of a list, or on tap. Turning it on or off here does not affect speech.</string>
    <string name="fbk_haptic_title">Haptic feedback</string>
    <string name="fbk_haptic_desc">Light tick when moving between elements, strong at the limit, click on tap.</string>
    <string name="fbk_sound_title">Sound cues</string>
    <string name="fbk_sound_desc">Short tick when moving; low tone at start/end; high tone on tap.</string>
    <string name="fbk_volume">Cue volume</string>
    <string name="fbk_test_haptic">Test haptic</string>
    <string name="fbk_test_sound">Test sound</string>
    <string name="fbk_quick">To switch quickly while in use, assign \"Change haptic and sound mode\" to a gesture, or pick it from the general menu.</string>
    <string name="rd_title">Reading content and notifications</string>
    <string name="rd_notif_title">Read new notifications</string>
    <string name="rd_notif_desc">Reads the app name and a shortened text; skips duplicates and merges bursts.</string>
    <string name="rd_unlabeled_head">Elements without a label</string>
    <string name="rd_unlabeled_intro">When an app doesn\'t label a button, the reader handles it in this order, without taking screenshots:</string>
    <string name="rd_unlabeled_1">1. The app\'s own label (description, text, linked label, tooltip).</string>
    <string name="rd_unlabeled_2">2. A label you assigned (see \"My labels\").</string>
    <string name="rd_unlabeled_3">3. Text of the child elements inside the button.</string>
    <string name="rd_unlabeled_4">4. A guess from the technical name, for example \"btn_close\" becomes \"close\", announced as \"guessed label\".</string>
    <string name="rd_unlabeled_5">5. Nothing found: reads \"button, no label\" so you can still tap it.</string>
    <string name="rd_ai_head">Functions assigned to gestures</string>
    <string name="rd_ai_body">Open \"Gestures\" to assign: Read text on screen (OCR), Describe image of the selected element and Label the selected element. The first two take a screenshot that is processed on the phone.</string>
    <string name="hp_title">Guide and limits</string>
    <string name="hp_basic_head">Basic use</string>
    <string name="hp_basic_1">Touch the screen with one finger to hear that element. Swipe right/left to move between elements. Double-tap anywhere to tap the element you just heard.</string>
    <string name="hp_basic_2">Every gesture can be reassigned in \"Gestures\".</string>
    <string name="hp_perm_head">Permissions the app uses</string>
    <string name="hp_perm_body">Only Accessibility (which you turn on yourself) and Vibration. The app asks for no network, contacts, location, microphone or storage permission. Scripts loaded from a file use the system file picker, so no storage permission is needed.</string>
    <string name="hp_limits_head">Honest limits</string>
    <string name="hp_limit_ocr">OCR uses ML Kit\'s Latin-script recognizer: it reads Latin text well, but accents may be wrong with small or blurry text, and other scripts (Chinese, Arabic, Cyrillic) are not recognized.</string>
    <string name="hp_limit_describe">\"Describe image\" only lists recognized objects (about 400 kinds, in English, translated where possible) and does not write full sentences.</string>
    <string name="hp_limit_secure">Android blocks screenshots on secure screens (passwords, banking).</string>
    <string name="hp_limit_edge">Android doesn\'t let an accessibility service capture edge swipes or drawn characters.</string>
    <string name="hp_translation_note">Translations were produced by machine and have not yet been reviewed by native speakers; please report wording problems.</string>
    <string name="mn_title">Quick menus</string>
    <string name="mn_intro">Two quick menus: general and element. The gestures below are the ones you have set.</string>
    <string name="mn_when_open">Swipe to choose, double-tap to run, go back to close.</string>
    <string name="mn_global_head">General menu</string>
    <string name="mn_local_head">Element menu</string>
    <string name="mn_local_extra">The app\'s own actions are added at the end. Text editing items appear only in input fields.</string>
    <string name="lb_title">My labels</string>
    <string name="lb_intro">Label buttons the app forgot to name: select the button, then use the gesture assigned to \"Label the selected element\" (see Gestures). The label is remembered for that exact button every time you open the app.</string>
    <string name="lb_limits">Only buttons with an internal identifier can be labeled. At most %1$d labels.</string>
    <string name="lb_empty">No labels yet.</string>
