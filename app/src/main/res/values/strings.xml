    <string name="st_service_title">Screen reader service</string>
    <string name="st_restricted_head">Note when installed outside Google Play</string>
    <string name="st_restricted_body">Android may grey out the service switch. In that case go to Settings → Apps → %1$s → ⋮ → Allow restricted settings, then turn the service on.</string>
    <string name="st_talkback">Turn off TalkBack before use, because both use touch exploration mode.</string>
    <string name="st_stable_head">Stable long-term running</string>
    <string name="st_stable_body">The accessibility service is kept running by the system and needs no separate background service. Some phones (Xiaomi, Oppo, Vivo, Samsung…) still stop apps to save battery. If the service turns off unexpectedly, set the app to unrestricted battery use.</string>
    <string name="st_battery_unrestricted">Currently: the app is NOT battery-restricted.</string>
    <string name="st_battery_optimized">Currently: the app is battery-optimized.</string>
    <string name="st_battery_button">Open battery optimization settings</string>
