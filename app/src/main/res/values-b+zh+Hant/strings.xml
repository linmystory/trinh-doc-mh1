    <string name="vo2_first_lang_title">第一引擎的語言</string>
    <string name="vo2_first_lang_desc">第一引擎朗讀的語言。預設跟隨應用程式語言。</string>
    <string name="vo2_first_lang_auto">與應用程式語言相同</string>
    <string name="rd_lift_title">抬手輸入</string>
    <string name="rd_lift_desc">開啟：在鍵盤上滑到某個按鍵即可聽到讀音，抬起手指即輸入該鍵。預設關閉；雙擊仍然可用。開始滑動手勢會取消輸入。</string>
    <string name="rd_touch_delay_title">觸控延遲</string>
    <string name="rd_touch_delay_desc">手指需在元素上停留多久才朗讀。0 表示立即朗讀；數值越大，滑過時越不會連續朗讀。</string>
    <string name="rd_touch_delay_value">%1$d 毫秒</string>
