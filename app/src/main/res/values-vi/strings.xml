    <string name="vo_lang_body">Giao diện và câu thông báo bằng giọng nói đều theo ngôn ngữ này. Giọng đọc cũng đọc bằng ngôn ngữ đó nên cần cài giọng tương ứng.</string>
    <string name="vo_lang_button">Chọn ngôn ngữ ứng dụng</string>
    <string name="vo_lang_unavailable">Không mở được cài đặt ngôn ngữ. Hãy mở Cài đặt → Hệ thống → Ngôn ngữ → Ngôn ngữ ứng dụng.</string>
    <string name="fbk_title">Âm báo và rung</string>
    <string name="fbk_intro">Phản hồi ngắn khi chuyển tiêu điểm, chạm đầu/cuối danh sách hoặc nhấn. Bật hay tắt ở đây không ảnh hưởng giọng đọc.</string>
    <string name="fbk_haptic_title">Rung phản hồi</string>
    <string name="fbk_haptic_desc">Rung nhẹ khi chuyển phần tử, rung mạnh khi chạm giới hạn, rung click khi nhấn.</string>
    <string name="fbk_sound_title">Âm báo</string>
    <string name="fbk_sound_desc">Tiếng tích ngắn khi chuyển phần tử; âm trầm khi tới đầu/cuối; âm cao khi nhấn.</string>
    <string name="fbk_volume">Âm lượng âm báo</string>
    <string name="fbk_test_haptic">Thử rung</string>
    <string name="fbk_test_sound">Thử âm báo</string>
    <string name="fbk_quick">Đổi nhanh chế độ khi đang dùng: gán chức năng \"Đổi chế độ rung và âm báo\" cho một cử chỉ, hoặc chọn trong trình đơn chung.</string>
    <string name="rd_title">Đọc nội dung và thông báo</string>
    <string name="rd_notif_title">Đọc thông báo mới</string>
    <string name="rd_notif_desc">Đọc tên ứng dụng và nội dung đã rút gọn; bỏ thông báo trùng, gộp khi dồn dập.</string>
    <string name="rd_unlabeled_head">Phần tử không có nhãn</string>
    <string name="rd_unlabeled_intro">Khi một nút không được ứng dụng gắn nhãn, trình đọc xử lý theo thứ tự sau, không cần chụp màn hình:</string>
    <string name="rd_unlabeled_1">1. Nhãn của ứng dụng (mô tả, chữ, nhãn liên kết, gợi ý công cụ).</string>
    <string name="rd_unlabeled_2">2. Nhãn do bạn tự gán (mục \"Nhãn của tôi\").</string>
    <string name="rd_unlabeled_3">3. Chữ của các phần tử con bên trong nút.</string>
    <string name="rd_unlabeled_4">4. Đoán theo tên kỹ thuật của nút, ví dụ \"btn_close\" thành \"đóng\", và báo \"nhãn đoán\".</string>
    <string name="rd_unlabeled_5">5. Không có gì: đọc \"nút không có nhãn\" để bạn vẫn nhấn được.</string>
    <string name="rd_ai_head">Chức năng gán vào cử chỉ</string>
    <string name="rd_ai_body">Vào mục \"Cử chỉ\" để gán: Đọc chữ trên màn hình (OCR), Mô tả hình ảnh của phần tử đang chọn và Gắn nhãn cho phần tử đang chọn. Hai chức năng đầu có chụp màn hình để xử lý ngay trên máy.</string>
    <string name="hp_title">Hướng dẫn và giới hạn</string>
    <string name="hp_basic_head">Cách dùng cơ bản</string>
    <string name="hp_basic_1">Chạm một ngón lên màn hình để nghe phần tử đó. Vuốt phải/trái để chuyển phần tử. Chạm hai lần ở bất kỳ đâu để nhấn phần tử vừa nghe.</string>
    <string name="hp_basic_2">Mọi cử chỉ có thể đổi chức năng trong mục \"Cử chỉ\".</string>
    <string name="hp_perm_head">Quyền ứng dụng sử dụng</string>
    <string name="hp_perm_body">Chỉ có Hỗ trợ tiếp cận (bạn tự bật) và Rung. Ứng dụng không xin quyền mạng, danh bạ, vị trí, micro hay bộ nhớ. Script nạp từ tệp dùng hộp chọn tệp của hệ thống nên không cần quyền bộ nhớ.</string>
    <string name="hp_limits_head">Giới hạn nói thẳng</string>
    <string name="hp_limit_ocr">OCR dùng bộ nhận dạng chữ Latin của ML Kit: đọc được chữ Việt ở mức cơ bản, dấu thanh có thể sai với chữ nhỏ hoặc mờ; chữ Hán, Ả Rập, Kirin chưa được nhận dạng.</string>
    <string name="hp_limit_describe">\"Mô tả hình ảnh\" chỉ liệt kê vật thể nhận ra (khoảng 400 loại), không viết thành câu văn.</string>
    <string name="hp_limit_secure">Android chặn chụp màn hình ở màn hình bảo mật (mật khẩu, ngân hàng).</string>
    <string name="hp_limit_edge">Android không cho dịch vụ hỗ trợ tiếp cận bắt cử chỉ vuốt từ cạnh màn hình hay vẽ ký tự.</string>
    <string name="hp_translation_note">Bản dịch các ngôn ngữ ngoài tiếng Việt do máy dịch và chưa được người bản ngữ rà soát; mong bạn góp ý khi gặp câu chưa tự nhiên.</string>
    <string name="mn_title">Trình đơn nhanh</string>
    <string name="mn_global_head">Trình đơn chung</string>
    <string name="mn_local_head">Trình đơn của phần tử</string>
    <string name="mn_local_extra">Cuối trình đơn có thêm hành động riêng của ứng dụng. Mục chỉnh sửa văn bản chỉ hiện ở ô nhập liệu.</string>
    <string name="lb_title">Nhãn của tôi</string>
    <string name="lb_intro">Gán nhãn cho nút mà ứng dụng quên đặt tên: chọn nút đó, rồi dùng cử chỉ được gán cho \"Gắn nhãn cho phần tử đang chọn\" (mục Cử chỉ). Nhãn được nhớ cho đúng nút ở mọi lần mở ứng dụng.</string>
